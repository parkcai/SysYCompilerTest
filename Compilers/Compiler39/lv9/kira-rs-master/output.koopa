decl @getint(): i32

decl @getch(): i32

decl @getarray(*i32): i32

decl @putint(i32)

decl @putch(i32)

decl @putarray(i32, *i32)

decl @starttime()

decl @stoptime()

fun @main(): i32 {
%entry:
  %ret = alloc i32
  @n = alloc i32
  @a = alloc [i32, 2]
  jump %0

%0:
  store 2, @n
  %1 = getelemptr @a, 0
  store 2, %1
  %2 = getelemptr @a, 1
  store 3, %2
  %3 = getelemptr @a, 0
  call @putarray(1, %3)
  jump %end

%end:
  %4 = load %ret
  ret %4
}
