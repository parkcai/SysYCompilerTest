decl @getint(): i32

decl @getch(): i32

decl @getarray(*i32): i32

decl @putint(i32)

decl @putch(i32)

decl @putarray(i32, *i32)

decl @starttime()

decl @stoptime()

fun @hanoi(@n: i32): i32 {
%entry:
  @n_0 = alloc i32
  store @n, @n_0
  %0 = load @n_0
  %1 = eq %0, 1
  br %1, %hanoi_true, %hanoi_false

%hanoi_true:
  ret 1

%hanoi_false:
  %2 = load @n_0
  %3 = sub %2, 1
  %4 = call @hanoi(%3)
  %5 = mul 2, %4
  %6 = add %5, 1
  ret %6

%hanoi_end:
  ret 0
}

fun @main(): i32 {
%entry:
  @n = alloc i32
  store 1, @n
  %7 = load @n
  %8 = call @hanoi(%7)
  call @putint(%8)
  ret 0
}
