decl @getint(): i32

decl @getch(): i32

decl @getarray(*i32): i32

decl @putint(i32)

decl @putch(i32)

decl @putarray(i32, *i32)

decl @starttime()

decl @stoptime()

fun @main(): i32 {
%entry:
  @a = alloc [i32, 3]
  %0 = getelemptr @a, 0
  store 0, %0
  %1 = getelemptr @a, 1
  store 0, %1
  %2 = getelemptr @a, 2
  store 0, %2
  @b = alloc [i32, 4]
  %3 = getelemptr @b, 0
  store 0, %3
  %4 = getelemptr @b, 1
  store 0, %4
  %5 = getelemptr @b, 2
  store 0, %5
  %6 = getelemptr @b, 3
  store 0, %6
  @c = alloc [i32, 7]
  %7 = getelemptr @c, 0
  store 0, %7
  %8 = getelemptr @c, 1
  store 0, %8
  %9 = getelemptr @c, 2
  store 0, %9
  %10 = getelemptr @c, 3
  store 0, %10
  %11 = getelemptr @c, 4
  store 0, %11
  %12 = getelemptr @c, 5
  store 0, %12
  %13 = getelemptr @c, 6
  store 0, %13
  @d = alloc [i32, 11]
  %14 = getelemptr @d, 0
  store 0, %14
  %15 = getelemptr @d, 1
  store 0, %15
  %16 = getelemptr @d, 2
  store 0, %16
  %17 = getelemptr @d, 3
  store 0, %17
  %18 = getelemptr @d, 4
  store 0, %18
  %19 = getelemptr @d, 5
  store 0, %19
  %20 = getelemptr @d, 6
  store 0, %20
  %21 = getelemptr @d, 7
  store 0, %21
  %22 = getelemptr @d, 8
  store 0, %22
  %23 = getelemptr @d, 9
  store 0, %23
  %24 = getelemptr @d, 10
  store 0, %24
  @e = alloc [i32, 2]
  %25 = getelemptr @e, 0
  store 0, %25
  %26 = getelemptr @e, 1
  store 0, %26
  @f = alloc [i32, 6]
  %27 = getelemptr @f, 0
  store 0, %27
  %28 = getelemptr @f, 1
  store 0, %28
  %29 = getelemptr @f, 2
  store 0, %29
  %30 = getelemptr @f, 3
  store 0, %30
  %31 = getelemptr @f, 4
  store 0, %31
  %32 = getelemptr @f, 5
  store 0, %32
  @g = alloc [i32, 9]
  %33 = getelemptr @g, 0
  store 0, %33
  %34 = getelemptr @g, 1
  store 0, %34
  %35 = getelemptr @g, 2
  store 0, %35
  %36 = getelemptr @g, 3
  store 0, %36
  %37 = getelemptr @g, 4
  store 0, %37
  %38 = getelemptr @g, 5
  store 0, %38
  %39 = getelemptr @g, 6
  store 0, %39
  %40 = getelemptr @g, 7
  store 0, %40
  %41 = getelemptr @g, 8
  store 0, %41
  ret 3
}
